# ==============================================================================
# FixFort Environment Configuration
# ==============================================================================

# Application Environment: development, demonstration, testing, production
ENVIRONMENT=demonstration

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Database URL (SQLite or PostgreSQL / Aiven Cloud)
DATABASE_URL=sqlite:///./fixfort.db
# PostgreSQL / Aiven Cloud Example:
# DATABASE_URL=postgresql://avnadmin:<YOUR_PASSWORD>@<AIVEN_HOST>:<PORT>/defaultdb?sslmode=require

# Shield URLs
LIVE_SHIELD_URL=http://localhost:8080
SANDBOX_SHIELD_URL=http://localhost:8081

# Container Names for Docker CLI operations
LIVE_SHIELD_CONTAINER=shield-live
SANDBOX_SHIELD_CONTAINER=shield-sandbox

# Shield Rules & Logs Paths (relative or absolute)
RULES_LIVE_DIR=./shield/rules-live
RULES_SANDBOX_DIR=./shield/rules-sandbox
SHIELD_LOGS_PATH=./shield/logs/access.log

# CORS Allowed Origins (comma-separated, no trailing slashes)
# Person C's Dashboard Vite default is http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Event Reader Polling Interval (seconds)
EVENT_POLL_INTERVAL_SEC=0.5

# Docker Execution Mode: 'docker' (uses subprocess docker CLI) or 'local' (filesystem validation only)
SHIELD_EXEC_MODE=docker

# Demo Helper Target URL (for POST /attack/{name})
DEMO_TARGET_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# AI engine (Person A brain) — Google Gemini
# Get a key from Google AI Studio and paste it here in your LOCAL .env only.
# Never commit a real key, never paste it in chat. Server-side only.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AQ.Ab8RN6Il5azf797Q_Au6PmhzgRvAjiFXF4qfGpBLfMRZsLnTNA
# Optional: force the deterministic offline proposer (no network, repeatable demo)
# FIXFORT_FORCE_OFFLINE=1

